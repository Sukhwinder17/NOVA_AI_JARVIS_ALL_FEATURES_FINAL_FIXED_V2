{
  "manifest_version": 3,
  "name": "NOVA WhatsApp Bridge",
  "version": "1.0.0",
  "description": "Connects NOVA desktop assistant to your existing Chrome WhatsApp Web tab.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "whatsapp_content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
