APP_NAME=NOVA AI
AI_PROVIDER=auto

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3-turbo

XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL=mistralai/mistral-large-2512

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash

DATALENS_URL=https://frontend-liard-rho-s59bfvv4uq.vercel.app
EVERYTHING_EXE=tools/bin/es.exe
NOVA_BROWSER_PROFILE=data/browser_profile
WHATSAPP_URL=https://web.whatsapp.com
NOVA_TTS_VOICE=David
NOVA_TTS_RATE=180

# SMSGate: immediate SMS can use your phone hotspot + Local Server.
# Scheduled SMS stays on the Cloud API because the Local Server does not
# currently provide scheduled dispatch.
SMSGATE_MODE=local
SMSGATE_LOCAL_URL=http://YOUR_PHONE_IP:8080

# These credentials are shown by SMSGate Local Server.
SMSGATE_LOGIN=
SMSGATE_PASSWORD=

# Cloud Server credentials (generated automatically when Cloud Server is activated)
SMSGATE_CLOUD_LOGIN=
SMSGATE_CLOUD_PASSWORD=

# Cloud endpoint used by NOVA when a message is scheduled.
SMSGATE_BASE_URL=https://api.sms-gate.app/3rdparty/v1
